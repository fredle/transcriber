<Window x:Class="MeetingTranscriber.MergeMeetingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge meetings" Height="420" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBg}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,14" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1" Text="Title for the merged meeting:" Margin="0,0,0,6"/>
        <TextBox x:Name="TitleBox" Grid.Row="2" KeyDown="OnKeyDown"/>

        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MeetingsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="4" Text="Their transcripts will be interleaved by time and the originals moved to the Recycle Bin."
                   Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,14,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Width="84" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
            <Button x:Name="MergeButton" Content="Merge" Width="84" IsDefault="True" Click="OnMerge"/>
        </StackPanel>
    </Grid>
</Window>
