<Window x:Class="MeetingTranscriber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teeline" Height="900" Width="1300"
        MinHeight="640" MinWidth="1000"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Display">

    <TabControl Background="{StaticResource WindowBg}" BorderThickness="0" Margin="14,10,14,14">

        <!-- ── Transcribe ─────────────────────────────────────────────── -->
        <TabItem Header="Transcribe">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="CallStatus" Grid.Row="0" Margin="2,0,2,12"
                           FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Dim}"
                           Text="Checking for a Teams call..."/>

                <!-- Devices, levels, and refresh: one compact row -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mic + speaker pickers -->
                        <StackPanel x:Name="DevicesRow" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Width="130" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Microphone · you" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="MicHint" Foreground="{StaticResource Mic}" FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </StackPanel>
                            <ComboBox x:Name="MicCombo" Width="160" VerticalAlignment="Center" Margin="0,0,18,0"
                                      SelectionChanged="OnMicComboChanged"/>

                            <StackPanel Width="130" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Speaker · others" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="SpkHint" Foreground="{StaticResource Spk}" FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </StackPanel>
                            <ComboBox x:Name="SpeakerCombo" Width="160" VerticalAlignment="Center"
                                      SelectionChanged="OnSpeakerComboChanged"/>

                            <Button x:Name="MatchTeamsButton" Content="Match Teams" Margin="14,0,0,0"
                                    VerticalAlignment="Center" Click="OnMatchTeams" Visibility="Collapsed"
                                    ToolTip="Switch the selection above to whatever Teams is currently using"/>
                        </StackPanel>

                        <!-- Level meters -->
                        <StackPanel x:Name="LevelsRow" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="24,0,0,0">
                            <StackPanel Width="60" Margin="0,0,14,0">
                                <TextBlock Text="Mic" Foreground="{StaticResource Mic}" FontSize="10" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="MicLevelBar" Height="6" Maximum="1" Margin="0,3,0,0"
                                             Foreground="{StaticResource Mic}"
                                             Background="{StaticResource TrackBg}" BorderThickness="0"/>
                            </StackPanel>
                            <StackPanel Width="60">
                                <TextBlock Text="Speaker" Foreground="{StaticResource Spk}" FontSize="10" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="SpkLevelBar" Height="6" Maximum="1" Margin="0,3,0,0"
                                             Foreground="{StaticResource Spk}"
                                             Background="{StaticResource TrackBg}" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="KeyRow" Grid.Column="3" Content="Refresh devices"
                                VerticalAlignment="Center" Click="OnRefreshDevices"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RecordButton" Grid.Column="0" Height="46"
                            Content="Start Transcribing" FontSize="15" FontWeight="SemiBold"
                            Foreground="White" Background="#2D6A4F" BorderBrush="#255B43"
                            Click="OnToggleRecording"/>
                    <Button x:Name="ScreenshotButton" Grid.Column="1" Height="46" Margin="10,0,0,0"
                            Padding="14,0" FontSize="13" FontWeight="SemiBold"
                            Content="Screenshot meeting" IsEnabled="False"
                            ToolTip="Copy a screenshot of the Teams meeting window to the clipboard and save it into this meeting's folder"
                            Click="OnScreenshotMeeting"/>
                </Grid>

                <!-- Output -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LiveTranscriptCol" Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="LiveTranscriptBorder" Grid.Column="0" Style="{StaticResource Card}"
                            Padding="14,12,6,14" Margin="0,0,5,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Live Transcription"
                                       FontWeight="SemiBold" Margin="0,0,8,10"/>
                            <RichTextBox x:Name="LiveTranscript" IsReadOnly="True"
                                         Background="{StaticResource Panel}"
                                         Foreground="{StaticResource Fg}"
                                         BorderThickness="0" FontSize="13"
                                         Padding="0,0,8,0"
                                         VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,12,6,14" Margin="5,0,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,8,10">
                                <TextBlock Text="Notes" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="NotesMaximizeButton" Content="Maximize"
                                        HorizontalAlignment="Right" Padding="9,3" FontSize="11"
                                        Click="OnToggleNotesMaximize"/>
                            </Grid>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="B" FontWeight="Bold" Width="28" Padding="0"
                                        Command="ToggleBold" CommandTarget="{Binding ElementName=NotesBox}"/>
                                <Button Content="I" FontStyle="Italic" Width="28" Padding="0" Margin="4,0,0,0"
                                        Command="ToggleItalic" CommandTarget="{Binding ElementName=NotesBox}"/>
                                <Button Width="28" Padding="0" Margin="4,0,0,0"
                                        Command="ToggleUnderline" CommandTarget="{Binding ElementName=NotesBox}">
                                    <TextBlock Text="U" TextDecorations="Underline"/>
                                </Button>
                                <Button Content="•" Width="28" Padding="0" Margin="4,0,0,0"
                                        Command="ToggleBullets" CommandTarget="{Binding ElementName=NotesBox}"/>
                            </StackPanel>
                            <Border x:Name="LiveScreenshotsPanel" DockPanel.Dock="Bottom"
                                    Style="{StaticResource Card}" Padding="8" Margin="0,10,8,0"
                                    Visibility="Collapsed">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock Text="Screenshots" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock x:Name="LiveScreenshotCounter" HorizontalAlignment="Right"
                                                   FontSize="11" Foreground="{StaticResource Dim}"/>
                                    </Grid>
                                    <Grid Height="170">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="LiveScreenshotPrevButton" Grid.Column="0" Content="◀"
                                                Width="28" VerticalAlignment="Center" Click="OnLiveScreenshotPrev"/>
                                        <Image x:Name="LiveScreenshotImage" Grid.Column="1" Stretch="Uniform"
                                               Margin="6,0"/>
                                        <Button x:Name="LiveScreenshotNextButton" Grid.Column="2" Content="▶"
                                                Width="28" VerticalAlignment="Center" Click="OnLiveScreenshotNext"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border x:Name="LiveAttendeesPanel" DockPanel.Dock="Bottom"
                                    Style="{StaticResource Card}" Padding="8" Margin="0,10,8,0"
                                    Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Attendees" FontWeight="SemiBold"
                                               FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="LiveAttendeesSummary" DockPanel.Dock="Top" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <ListBox x:Name="LiveAttendeeLogList" MaxHeight="90" FontSize="11"
                                             Foreground="{StaticResource Dim}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </DockPanel>
                            </Border>
                            <Grid>
                                <RichTextBox x:Name="NotesBox" IsEnabled="False"
                                             Background="{StaticResource Panel}"
                                             Foreground="{StaticResource Fg}"
                                             BorderThickness="0" FontSize="13"
                                             Padding="0,0,8,0"
                                             AcceptsTab="True"
                                             VerticalScrollBarVisibility="Auto"
                                             TextChanged="OnNotesChanged"/>
                                <TextBlock x:Name="NotesHint"
                                           Text="Start transcribing to take notes for this meeting."
                                           Foreground="{StaticResource Dim}" FontSize="12"
                                           TextWrapping="Wrap" IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ── Recent Meetings ────────────────────────────────────────── -->
        <TabItem Header="Recent Meetings">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,5,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="2,0,2,10">
                            <TextBlock Text="Recent Meetings" FontWeight="SemiBold" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="MergeMeetingsButton" Content="Merge" Margin="0,0,6,0"
                                        Padding="9,4" Visibility="Collapsed" Click="OnMergeMeetings"/>
                                <Button Content="Refresh" Padding="9,4" Click="OnRefreshMeetings"/>
                            </StackPanel>
                        </Grid>

                        <Grid DockPanel.Dock="Top" Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="FolderList" Grid.Column="0" MaxHeight="90"
                                     SelectionChanged="OnFolderSelected"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelAlt}"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                CornerRadius="12" Padding="9,4" Margin="0,0,5,5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Label}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Column="1" Content="+ Folder" Padding="7,4"
                                    VerticalAlignment="Top" Click="OnCreateFolder"/>
                        </Grid>

                        <ListBox x:Name="MeetingList" SelectionChanged="OnMeetingSelected"
                                 SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,3"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1.5" CornerRadius="8" Padding="10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource PanelAlt}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10"
                                                           Foreground="{StaticResource Dim}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding GroupLabel}" FontSize="10"
                                                           Foreground="{StaticResource Dim}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Top">
                                                <Button Width="26" Height="26" Padding="0"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{StaticResource Dim}" Margin="0,0,2,0"
                                                        ToolTip="Move to folder"
                                                        Click="OnMoveMeetingClick">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Stroke="{StaticResource Dim}" StrokeThickness="1.6"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Data="M3,7.5 A2,2 0 0 1 5,5.5 L9,5.5 L11,8 L19,8
                                                                    A2,2 0 0 1 21,10 L21,18 A2,2 0 0 1 19,20
                                                                    L5,20 A2,2 0 0 1 3,18 Z"/>
                                                    </Viewbox>
                                                </Button>
                                                <Button Width="26" Height="26" Padding="0"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{StaticResource Dim}"
                                                        ToolTip="Delete this transcription"
                                                        Click="OnDeleteRecording">
                                                    <Viewbox Width="13" Height="13">
                                                        <Path Stroke="{StaticResource Dim}" StrokeThickness="2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Data="M3,6 L21,6 M8,6 L8,4 A2,2 0 0 1 10,2 L14,2 A2,2 0 0 1 16,4 L16,6
                                                                    M19,6 L18,20 A2,2 0 0 1 16,22 L8,22 A2,2 0 0 1 6,20 L5,6
                                                                    M10,11 L10,17 M14,11 L14,17"/>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" Margin="5,0,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="2,0,2,10">
                            <TextBlock x:Name="ViewerTitle" Text="No meeting selected"
                                       FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Cursor="Hand" ToolTip="Click to rename"
                                       MouseLeftButtonUp="OnRenameMeetingClick"/>
                            <TextBox x:Name="ViewerTitleEdit" FontWeight="SemiBold" FontSize="14"
                                     VerticalAlignment="Center" HorizontalAlignment="Left"
                                     MinWidth="220" Visibility="Collapsed"
                                     KeyDown="OnViewerTitleEditKeyDown"
                                     LostFocus="OnViewerTitleEditLostFocus"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ChangeSpeakerButton" Content="Change speaker"
                                        Padding="9,4" Visibility="Collapsed" Click="OnChangeSpeaker"/>
                                <Button x:Name="DeleteLinesButton" Content="Delete lines" Margin="6,0,0,0"
                                        Foreground="{StaticResource Danger}" Padding="9,4"
                                        Visibility="Collapsed" Click="OnDeleteLines"/>
                                <Button x:Name="SpeakersButton" Content="Speakers" Margin="6,0,0,0"
                                        Padding="9,4" Visibility="Collapsed" Click="OnManageSpeakers"/>
                                <Button x:Name="AskButton" Content="Ask about this meeting" Margin="6,0,0,0"
                                        Padding="9,4" Visibility="Collapsed" Click="OnAskAboutMeeting"/>
                                <Button x:Name="OpenFolderButton" Content="Open folder" Margin="6,0,0,0"
                                        Padding="9,4" Visibility="Collapsed" Click="OnOpenFolder"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="TranscriptList" Grid.Column="0"
                                     SelectionMode="Extended" FontSize="13"
                                     SelectionChanged="OnTranscriptSelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                                          Background="Transparent"/>

                            <DockPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="Notes" FontWeight="SemiBold" Margin="4,0,0,8"/>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,8">
                                    <Button Content="B" FontWeight="Bold" Width="28" Padding="0"
                                            Command="ToggleBold" CommandTarget="{Binding ElementName=MeetingNotesBox}"/>
                                    <Button Content="I" FontStyle="Italic" Width="28" Padding="0" Margin="4,0,0,0"
                                            Command="ToggleItalic" CommandTarget="{Binding ElementName=MeetingNotesBox}"/>
                                    <Button Width="28" Padding="0" Margin="4,0,0,0"
                                            Command="ToggleUnderline" CommandTarget="{Binding ElementName=MeetingNotesBox}">
                                        <TextBlock Text="U" TextDecorations="Underline"/>
                                    </Button>
                                    <Button Content="•" Width="28" Padding="0" Margin="4,0,0,0"
                                            Command="ToggleBullets" CommandTarget="{Binding ElementName=MeetingNotesBox}"/>
                                </StackPanel>
                                <Border x:Name="ScreenshotsPanel" DockPanel.Dock="Bottom"
                                        Style="{StaticResource Card}" Padding="8" Margin="4,10,0,0"
                                        Visibility="Collapsed">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <TextBlock Text="Screenshots" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock x:Name="ScreenshotCounter" HorizontalAlignment="Right"
                                                       FontSize="11" Foreground="{StaticResource Dim}"/>
                                        </Grid>
                                        <Grid Height="170">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="ScreenshotPrevButton" Grid.Column="0" Content="◀"
                                                    Width="28" VerticalAlignment="Center" Click="OnScreenshotPrev"/>
                                            <Image x:Name="ScreenshotImage" Grid.Column="1" Stretch="Uniform"
                                                   Margin="6,0"/>
                                            <Button x:Name="ScreenshotNextButton" Grid.Column="2" Content="▶"
                                                    Width="28" VerticalAlignment="Center" Click="OnScreenshotNext"/>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="ViewerAttendeesPanel" DockPanel.Dock="Bottom"
                                        Style="{StaticResource Card}" Padding="8" Margin="4,10,0,0"
                                        Visibility="Collapsed">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Attendees" FontWeight="SemiBold"
                                                   FontSize="12" Margin="0,0,0,6"/>
                                        <ListBox x:Name="ViewerAttendeesList" MaxHeight="140" FontSize="12"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                                <Grid>
                                    <RichTextBox x:Name="MeetingNotesBox" IsEnabled="False"
                                                 Background="{StaticResource Panel}"
                                                 Foreground="{StaticResource Fg}"
                                                 BorderThickness="0" FontSize="13"
                                                 Padding="4,0,0,0"
                                                 AcceptsTab="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextChanged="OnMeetingNotesChanged"/>
                                    <TextBlock x:Name="MeetingNotesHint"
                                               Text="Select a meeting to view or edit its notes."
                                               Foreground="{StaticResource Dim}" FontSize="12"
                                               TextWrapping="Wrap" IsHitTestVisible="False" Margin="4,0,0,0"/>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>
        <!-- ── Settings ───────────────────────────────────────────────── -->
        <TabItem Header="Settings">
            <StackPanel Margin="0,0,0,0" VerticalAlignment="Top">
                <Border Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="AssemblyAI API key" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Used to transcribe your meetings. Get a key from assemblyai.com."
                                   Foreground="{StaticResource Dim}" FontSize="11" Margin="0,4,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox" Grid.Column="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Save key" Margin="8,0,0,0" Click="OnSaveKey"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
