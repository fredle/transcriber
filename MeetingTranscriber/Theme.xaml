<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette. The channel colours are darkened versions of the
         original teal/orange so they keep enough contrast on white for
         body text; the pale originals were only legible on a dark panel. -->
    <Color x:Key="WindowBgColor">#F3F3F3</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <Color x:Key="PanelAltColor">#F0F0F0</Color>
    <Color x:Key="BorderColor">#D8D8D8</Color>
    <Color x:Key="FgColor">#1F1F1F</Color>
    <Color x:Key="DimColor">#6A6A6A</Color>
    <Color x:Key="MicColor">#0E7C66</Color>
    <Color x:Key="SpkColor">#B4530A</Color>
    <Color x:Key="DangerColor">#B3261E</Color>
    <Color x:Key="StartColor">#2D6A4F</Color>
    <Color x:Key="StopColor">#B3261E</Color>
    <Color x:Key="InCallColor">#1B7F4B</Color>

    <SolidColorBrush x:Key="WindowBg" Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelAlt" Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="Fg" Color="{StaticResource FgColor}"/>
    <SolidColorBrush x:Key="Dim" Color="{StaticResource DimColor}"/>
    <SolidColorBrush x:Key="Mic" Color="{StaticResource MicColor}"/>
    <SolidColorBrush x:Key="Spk" Color="{StaticResource SpkColor}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="TrackBg" Color="#E4E4E4"/>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Padding" Value="14,6"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    </Style>

</ResourceDictionary>
